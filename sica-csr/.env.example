# Copiar a .env y ajustar. Nunca subir el .env al repositorio.

# Puertos de docker compose (cambiar si alguno ya está ocupado)
PUERTO_WEB=5174
PUERTO_API=8000
PUERTO_DB=5432

# Base de datos
DATABASE_URL=postgresql+psycopg://sica:sica@localhost:5432/sica
DATABASE_URL_PRUEBAS=postgresql+psycopg://sica:sica@localhost:5432/sica_pruebas

# Seguridad (cambiar en cada entorno)
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=480

# Frontend permitido por CORS (separar con comas)
CORS_ORIGENES=http://localhost:5173

# Recordatorios (minutos entre cada revisión de pendientes)
RECORDATORIOS_ACTIVOS=false
RECORDATORIOS_INTERVALO_MIN=10

# Mensajería: si se dejan vacíos, los mensajes se muestran en consola (modo desarrollo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO_SMS=
TWILIO_NUMERO_WHATSAPP=
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
